{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../../dist/out-tsc",
    "module": "commonjs",
    "lib": [
      "es2015",
      "es2016",
      "es2017",
      "es2022.error",
      "esnext.disposable"
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.node.ts",
    "src/**/*.d.ts",
    "integration-test/**/*.spec.ts"
  ],
  "exclude": []
}
