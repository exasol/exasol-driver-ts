{
  "name": "@exasol/exasol-driver-ts",
  "version": "0.5.0",
  "description": "Exasol SQL Driver",
  "scripts": {
    "audit": "npm run audit:prod && npm run audit:full",
    "audit:prod": "npm audit --omit=dev",
    "audit:full": "audit-ci --config ./audit-ci.jsonc",
    "trace": "./.github/workflows/oftw.sh trace --output-format plain --report-verbosity failure_details --color-scheme color --log-level WARNING",
    "trace:report": "./.github/workflows/oftw.sh trace --output-format html --report-verbosity all --log-level WARNING --output-file dist/trace-report.html",
    "build": "rollup --failAfterWarnings --config rollup.config.mjs",
    "watch": "rollup --failAfterWarnings --watch --config rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit-dom unit-node --coverage",
    "test:dom": "jest --selectProjects unit-dom --coverage",
    "test:node": "jest --selectProjects unit-node --coverage",
    "lint": "eslint --ext .js,.ts --fix .",
    "lint:ci": "eslint --ext .js,.ts .",
    "format": "prettier --write .",
    "itest": "jest --selectProjects itest-dom itest-node --coverage",
    "itest:dom": "jest --selectProjects itest-dom --coverage",
    "itest:node": "jest --selectProjects itest-node --coverage",
    "test:all": "jest --selectProjects unit-dom unit-node itest-dom itest-node --coverage"
  },
  "dependencies": {
    "generic-pool": "^3.9.0",
    "node-forge": "^1.4.0",
    "pako": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^3.0.0",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "audit-ci": "^7.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "ws": "^8.21.3"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/exasol/exasol-driver-ts"
  },
  "keywords": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/exasol/exasol-driver-ts/issues"
  },
  "homepage": "https://github.com/exasol/exasol-driver-ts#readme"
}
