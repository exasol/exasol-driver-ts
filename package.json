{
  "name": "@exasol/exasol-driver-ts",
  "version": "0.7.0",
  "description": "Exasol SQL Driver",
  "type": "module",
  "scripts": {
    "audit": "npm run audit:prod && npm run audit:full",
    "audit:prod": "npm audit --omit=dev",
    "audit:full": "audit-ci --config ./audit-ci.jsonc",
    "trace": "./.github/workflows/oftw.sh trace --output-format plain --report-verbosity failure_details --color-scheme color --log-level WARNING doc src integration-test rollup.config.mjs",
    "trace:report": "mkdir -p dist/docs/trace && ./.github/workflows/oftw.sh trace --output-format html --report-verbosity all --log-level WARNING --output-file dist/docs/trace/index.html doc src integration-test rollup.config.mjs",
    "docs:api": "typedoc",
    "build": "rollup --failAfterWarnings --config rollup.config.mjs && node scripts/add-js-extensions-to-declarations.mjs",
    "watch": "rollup --failAfterWarnings --watch --config rollup.config.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.spec.dom.json && tsc --noEmit --project tsconfig.spec.json",
    "lint": "eslint --ext .js,.ts --fix .",
    "lint:ci": "eslint --max-warnings 0 --ext .js,.ts .",
    "format": "prettier --write .",
    "test": "jest --selectProjects unit-dom unit-node --coverage",
    "test:package": "npm run build && tsc --ignoreConfig --noEmit --module ESNext --moduleResolution Bundler --target ES2022 --lib ES2022,ESNext.Disposable,DOM integration-test/package/browser-package-smoke.ts && tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,ESNext.Disposable,DOM integration-test/package/browser-package-smoke.ts && node integration-test/package/browser-package-smoke.mjs",
    "itest:node": "jest --selectProjects itest-node --coverage",
    "itest": "jest --selectProjects itest-dom itest-node --coverage",
    "test:all": "jest --selectProjects unit-dom unit-node itest-dom itest-node --coverage && npm run test:package"
  },
  "dependencies": {
    "generic-pool": "^3.9.0",
    "node-forge": "^1.4.0",
    "pako": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^3.0.0",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "audit-ci": "^7.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "globals": "^17.9.0",
    "hyparquet-writer": "^0.16.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "ws": "^8.21.3"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.esm.js",
      "require": "./dist/browser.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exasol/exasol-driver-ts"
  },
  "keywords": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/exasol/exasol-driver-ts/issues"
  },
  "homepage": "https://github.com/exasol/exasol-driver-ts#readme",
  "allowScripts": {
    "cpu-features": false,
    "protobufjs": false,
    "ssh2": false,
    "unrs-resolver": false,
    "@parcel/watcher": false
  }
}
