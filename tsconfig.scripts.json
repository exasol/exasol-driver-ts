{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "target": "ES2022",
    "module": "ESNext",
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.mjs",
    "rollup.config.mjs",
    "eslint.config.mjs"
  ],
  "exclude": []
}
